#version 450
// Screen Space Ambient Occlusion (SSAO) - Poisson Disk Hemisphere Sampling
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D depthTex;
layout(binding = 1, r8) uniform writeonly image2D dstAO;

layout(push_constant) uniform PushConsts {
    ivec2 size;
    vec4 proj_info; // (2/P00, 2/P11, -(1+P02)/P00, -(1+P12)/P11)
    vec4 params;    // (radius, bias, intensity, reverse_z)
} pc;

// 16 Poisson-disk hemisphere sample offsets
const vec3 SAMPLES[16] = vec3[16](
    vec3( 0.042,  0.125,  0.218), vec3(-0.165,  0.134,  0.412),
    vec3( 0.281, -0.219,  0.125), vec3(-0.312, -0.198,  0.345),
    vec3( 0.115,  0.482,  0.187), vec3(-0.254,  0.412,  0.512),
    vec3( 0.498,  0.187,  0.284), vec3(-0.521,  0.245,  0.312),
    vec3( 0.312, -0.482,  0.598), vec3(-0.412, -0.498,  0.412),
    vec3( 0.612, -0.125,  0.712), vec3(-0.645, -0.215,  0.698),
    vec3( 0.187,  0.725,  0.612), vec3(-0.312,  0.798,  0.498),
    vec3( 0.785,  0.312,  0.812), vec3(-0.812,  0.412,  0.785)
);

// Pseudo-random rotation hash from pixel coordinate
float hash(vec2 p) {
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

vec3 reconstruct_view_pos(ivec2 p, float d) {
    vec2 uv = (vec2(p) + 0.5) / vec2(pc.size);
    // Linearize depth depending on reverse-z (reverse-z: near=1, far=0)
    float z = (pc.params.w > 0.5) ? (1.0 / max(d, 0.0001)) : (1.0 / max(1.0 - d, 0.0001));
    vec2 ndc = uv * 2.0 - 1.0;
    return vec3(ndc * pc.proj_info.xy + pc.proj_info.zw, 1.0) * z;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;

    float d = texelFetch(depthTex, p, 0).r;
    // Skip background/sky
    if ((pc.params.w > 0.5 && d <= 0.0001) || (pc.params.w <= 0.5 && d >= 0.9999)) {
        imageStore(dstAO, p, vec4(1.0));
        return;
    }

    vec3 P = reconstruct_view_pos(p, d);

    // Compute normal from depth derivatives
    ivec2 pr = min(p + ivec2(1, 0), pc.size - 1);
    ivec2 pb = min(p + ivec2(0, 1), pc.size - 1);
    float dr = texelFetch(depthTex, pr, 0).r;
    float db = texelFetch(depthTex, pb, 0).r;
    vec3 Pr = reconstruct_view_pos(pr, dr);
    vec3 Pb = reconstruct_view_pos(pb, db);
    vec3 N = normalize(cross(Pr - P, Pb - P));
    if (N.z < 0.0) N = -N;

    // Random rotation around normal
    float rot_angle = hash(vec2(p)) * 6.2831853;
    vec3 rvec = vec3(cos(rot_angle), sin(rot_angle), 0.0);
    vec3 tangent = normalize(rvec - N * dot(rvec, N));
    vec3 bitangent = cross(N, tangent);
    mat3 tbn = mat3(tangent, bitangent, N);

    float radius = pc.params.x;
    float bias = pc.params.y;
    float occlusion = 0.0;

    for (int i = 0; i < 16; i++) {
        vec3 sample_dir = tbn * SAMPLES[i];
        vec3 sample_pos = P + sample_dir * radius;

        // Project sample_pos back to screen coordinates
        vec2 sample_ndc = sample_pos.xy / (sample_pos.z * pc.proj_info.xy) - pc.proj_info.zw / pc.proj_info.xy;
        vec2 sample_uv = sample_ndc * 0.5 + 0.5;
        ivec2 sample_p = ivec2(sample_uv * vec2(pc.size));

        if (sample_p.x >= 0 && sample_p.x < pc.size.x && sample_p.y >= 0 && sample_p.y < pc.size.y) {
            float sample_d = texelFetch(depthTex, sample_p, 0).r;
            vec3 actual_pos = reconstruct_view_pos(sample_p, sample_d);

            float range_check = smoothstep(0.0, 1.0, radius / max(length(P - actual_pos), 0.001));
            occlusion += (actual_pos.z <= sample_pos.z - bias ? 1.0 : 0.0) * range_check;
        }
    }

    float ao = clamp(1.0 - (occlusion / 16.0), 0.0, 1.0);
    imageStore(dstAO, p, vec4(ao, 0.0, 0.0, 1.0));
}
