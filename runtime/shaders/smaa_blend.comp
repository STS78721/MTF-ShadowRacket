#version 450
// SMAA Blending Weight Calculation - Subpixel Morphological Anti-Aliasing
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D edgesTex;
layout(binding = 1) uniform sampler2D areaTex;
layout(binding = 2) uniform sampler2D searchTex;
layout(binding = 3, rgba8) uniform writeonly image2D dstBlend;

layout(push_constant) uniform PushConsts {
    ivec2 size;
    vec4 rt_metrics; // (1/w, 1/h, w, h)
} pc;

#define SMAA_AREATEX_MAX_DISTANCE 16.0
#define SMAA_AREATEX_PIXEL_SIZE (vec2(1.0 / 160.0, 1.0 / 560.0))

vec2 sample_area(vec2 d, float e1, float e2) {
    vec2 tc = SMAA_AREATEX_MAX_DISTANCE * round(4.0 * vec2(e1, e2)) + d;
    tc = tc * SMAA_AREATEX_PIXEL_SIZE + 0.5 * SMAA_AREATEX_PIXEL_SIZE;
    return textureLod(areaTex, tc, 0.0).rg;
}

float search_x_left(ivec2 p) {
    int x = p.x - 1;
    int limit = max(0, p.x - int(SMAA_AREATEX_MAX_DISTANCE));
    while (x >= limit) {
        vec2 e = texelFetch(edgesTex, ivec2(x, p.y), 0).rg;
        if (e.g < 0.9 || e.r > 0.1) break;
        x--;
    }
    return float(p.x - x);
}

float search_x_right(ivec2 p) {
    int x = p.x + 1;
    int limit = min(pc.size.x - 1, p.x + int(SMAA_AREATEX_MAX_DISTANCE));
    while (x <= limit) {
        vec2 e = texelFetch(edgesTex, ivec2(x, p.y), 0).rg;
        if (e.g < 0.9 || e.r > 0.1) break;
        x++;
    }
    return float(x - p.x);
}

float search_y_up(ivec2 p) {
    int y = p.y - 1;
    int limit = max(0, p.y - int(SMAA_AREATEX_MAX_DISTANCE));
    while (y >= limit) {
        vec2 e = texelFetch(edgesTex, ivec2(p.x, y), 0).rg;
        if (e.r < 0.9 || e.g > 0.1) break;
        y--;
    }
    return float(p.y - y);
}

float search_y_down(ivec2 p) {
    int y = p.y + 1;
    int limit = min(pc.size.y - 1, p.y + int(SMAA_AREATEX_MAX_DISTANCE));
    while (y <= limit) {
        vec2 e = texelFetch(edgesTex, ivec2(p.x, y), 0).rg;
        if (e.r < 0.9 || e.g > 0.1) break;
        y++;
    }
    return float(y - p.y);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;

    vec2 e = texelFetch(edgesTex, p, 0).rg;
    vec4 weights = vec4(0.0);

    // Edge at north (horizontal line)
    if (e.g > 0.0) {
        float d1 = search_x_left(p);
        float d2 = search_x_right(p);

        int x1 = max(0, p.x - int(d1));
        int x2 = min(pc.size.x - 1, p.x + int(d2));
        float e1 = texelFetch(edgesTex, ivec2(x1, p.y), 0).r;
        float e2 = texelFetch(edgesTex, ivec2(x2, p.y), 0).r;

        weights.rg = sample_area(sqrt(vec2(d1, d2)), e1, e2);
    }

    // Edge at west (vertical line)
    if (e.r > 0.0) {
        float d1 = search_y_up(p);
        float d2 = search_y_down(p);

        int y1 = max(0, p.y - int(d1));
        int y2 = min(pc.size.y - 1, p.y + int(d2));
        float e1 = texelFetch(edgesTex, ivec2(p.x, y1), 0).g;
        float e2 = texelFetch(edgesTex, ivec2(p.x, y2), 0).g;

        weights.ba = sample_area(sqrt(vec2(d1, d2)), e1, e2);
    }

    imageStore(dstBlend, p, weights);
}
