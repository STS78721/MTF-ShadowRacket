; Mario Tennis Fever (NS2-to-PC) default configuration template.
; The game creates mtf.ini automatically on first change in the in-game menu,
; or uses built-in clean defaults when mtf.ini does not exist.
;
; Keep defaults neutral so every user starts smoothly regardless of GPU/display.

[graphics]
window_size = 1920x1080
fullscreen = 0
output_res = 1920x1080
resolution = original
upscaler = fsr
sharpness = 80
fg_mode = off
color_preset = default
fps_limit = 60
pipe_skip = any

[gameplay]
; Free camera speed multiplier
; camera_speed = 1.0
