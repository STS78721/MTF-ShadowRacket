[paths]
exefs = ./exefs
romfs = ./romfs

[performance]
experimental_geometry = 1
native_gs = 1
nx2_read_nowait = 1
replay_async = 1
LANG = en-US
MENU_LANG = en

[display]
window_size = 1920x1080
fullscreen = 1
output_res = 3840x2160
render_scale = 50
perf_overlay = fps
upscaler = dlss
upscaler_preset = performance
dlss_preset = preset_m
reflex = on
low_latency = boost
frame_gen = 0
dlaa = 0
fov = 100
color_gamma = 0.95
color_preset = vivid
color_brightness = 0
color_contrast = 115
color_saturation = 135
vk_present = mailbox
antilag2 = off
smaa = 0
fxaa = 1
ao = off
ao_intensity = 1.0
fg_mode = dlss_fg
fg_mult = 6x
fg_flow = 50
fg_type = fixed

[frame rate]
fps_limit = 120
realtime = 1
cloth_realtime = 1

[input]
bind_b = key:y, pad:default
rumble_strength = 160
