+        private static bool IsFragCoordOperand(Operand op)
+        {
+            if (op == null)
+            {
+                return false;
+            }
+
+            if (op.Type == OperandType.LocalVariable && op.AsgOp is Operation operation)
+            {
+                if ((operation.Inst & Instruction.Mask) == Instruction.Divide)
+                {
+                    return IsFragCoordOperand(operation.GetSource(0));
+                }
+                if (operation.Inst == Instruction.Load && operation.StorageKind == StorageKind.Input)
+                {
+                    Operand src0 = operation.GetSource(0);
+                    return (IoVariable)src0.Value == IoVariable.FragmentCoord;
+                }
+            }
+            return false;
+        }
